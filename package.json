{
  "name": "handymgr2",
  "version": "9.8.25",
  "description": "HandyManager Dashboard",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-build-version.mjs && node -e \"const fs=require('fs');fs.mkdirSync('dist/css',{recursive:true});fs.copyFileSync('src/css/app.css','dist/css/app.css');console.log('CSS copied to dist/css/app.css');\"",
    "start": "npx tsx backend/server.ts",
    "server:dev": "npx tsx backend/server.ts",
    "build:gh": "vite build --base=/handymgr2/ && node scripts/stamp-build-version.mjs",
    "prepare:preview-subdir": "node scripts/prepare-preview-subdir.mjs",
    "db:health": "node scripts/turso-healthcheck.mjs",
    "db:migrate": "node scripts/apply-pg-sql.mjs",
    "backfill:appfolio": "npx tsx scripts/backfill.ts",
    "deploy": "npm run build:gh && gh-pages -d dist",
    "preview": "vite preview",
    "preview:4173": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "live": "npm run build && npm run prepare:preview-subdir && npm run preview:4173",
    "test": "node --test backend/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "ag-grid-community": "^36.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.2",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "jose": "^6.2.3",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "gh-pages": "^6.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  }
}
