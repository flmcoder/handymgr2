{
  "name": "handymgr2",
  "version": "9.7.8",
  "description": "HandyManager Dashboard",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npx tsx backend/server.ts",
    "server:dev": "npx tsx backend/server.ts",
    "build:gh": "vite build --base=/handymgr2/",
    "prepare:preview-subdir": "node scripts/prepare-preview-subdir.mjs",
    "db:health": "node scripts/turso-healthcheck.mjs",
    "deploy": "npm run build:gh && gh-pages -d dist",
    "preview": "vite preview",
    "preview:4173": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "live": "npm run build && npm run prepare:preview-subdir && npm run preview:4173",
    "typecheck": "tsx --noSwc npx tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "@libsql/client": "^0.17.3",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  }
}
