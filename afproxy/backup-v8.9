      "property_id",
      "unit",
      "unit_id",
      "tenant",
      "status",
      "move_out",
      "move_in",
      "phone_numbers",
      "emails",
      "occupancy_id",
      "rent",
    ],
  });

  // Filter: only tenants with a move_out date within the window
