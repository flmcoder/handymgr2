// ---------- ping (health check — tests both API domains like v7) ------------
async function handlePing() {
  const t0 = Date.now();
  const [dbResp, rptResp] = await Promise.allSettled([
    fetch(`${AF_DB}/api/v0/properties?filters%5BLastUpdatedAtFrom%5D=2025-01-01T00%3A00%3A00Z&page%5Bsize%5D=1`, {
      headers: dbHeaders(),
    }),
    fetch(`${AF_REPORTS}/api/v2/reports/property_directory.json`, {
      method: "POST",
      headers: { ...reportsHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({
        property_visibility: "active",
        paginate_results: true,
        per_page: 1,
      }),
    }),
  ]);
  const elapsed = Date.now() - t0;
  const dbOk = dbResp.status === "fulfilled" && dbResp.value.ok;
  const rptOk = rptResp.status === "fulfilled" && rptResp.value.ok;

  let dbDetail = "";
  let rptDetail = "";
  try {
    if (dbResp.status === "fulfilled") {
      dbDetail = (await dbResp.value.text()).substring(0, 200);
    }
  } catch {}
  try {
    if (rptResp.status === "fulfilled") {
      rptDetail = (await rptResp.value.text()).substring(0, 100);
    }
  } catch {}

  return {
    ok: dbOk || rptOk, // ok if EITHER API is reachable (not both)
    db_api: {
      ok: dbOk,
      domain: AF_DB,
      status: dbResp.status === "fulfilled" ? dbResp.value.status : 0,
      detail: dbOk ? "Connected" : dbDetail,
    },
    reports_api: {
      ok: rptOk,
      domain: AF_REPORTS,
      status: rptResp.status === "fulfilled" ? rptResp.value.status : 0,
      detail: rptOk ? "Connected" : rptDetail,
    },
    latency_ms: elapsed,
    timestamp: new Date().toISOString(),
    version: "v8.9",
    proxy: "v8.9",
    database: TURSO_URL ? "turso" : "valtown_sqlite",
    vhost: AF_VHOST,
  };
}

// ========================== DEBUG SQLITE =====================================
async function handleDebugSqlite(): Promise<any> {
  const diag: any = { ok: true, timestamp: new Date().toISOString() };

  // 1) List all tables and their schemas
  try {
    const tables = await sqlite.execute(
      `SELECT name, sql FROM sqlite_master WHERE type='table' ORDER BY name`,
    );
    diag.tables_raw = tables;
    diag.tables_obj = rowsAsObjects(tables);
  } catch (e: any) {
    diag.tables_error = e.message;
  }

  // 2) List all indexes
  try {
    const indexes = await sqlite.execute(
      `SELECT name, tbl_name, sql FROM sqlite_master WHERE type='index' ORDER BY tbl_name, name`,
    );
    diag.indexes_raw = indexes;
    diag.indexes_obj = rowsAsObjects(indexes);
  } catch (e: any) {
    diag.indexes_error = e.message;
  }

  // 3) PRAGMA table_info for each expected table
  for (const tbl of ["webhook_events", "api_cache", "turn_records"]) {
    try {
      const info = await sqlite.execute(`PRAGMA table_info(${tbl})`);
      diag[`pragma_${tbl}_raw`] = info;
      diag[`pragma_${tbl}_obj`] = rowsAsObjects(info);
    } catch (e: any) {
      diag[`pragma_${tbl}_error`] = e.message;
    }
  }

  // 4) Test a simple SELECT on webhook_events to see what happens
  try {
    const testSelect = await sqlite.execute(
      `SELECT * FROM webhook_events LIMIT 1`,
    );
    diag.webhook_test_raw = testSelect;
    diag.webhook_test_obj = rowsAsObjects(testSelect);
  } catch (e: any) {
    diag.webhook_test_error = e.message;
  }

  // 5) Test a simple SELECT on api_cache
  try {
    const cacheTest = await sqlite.execute(
      `SELECT cache_key, entity_type, cached_at, record_count FROM api_cache LIMIT 3`,
    );
    diag.cache_test_raw = cacheTest;
    diag.cache_test_obj = rowsAsObjects(cacheTest);
  } catch (e: any) {
    diag.cache_test_error = e.message;
  }

  // 6) Show _tablesReady state
  diag._tablesReady = _tablesReady;

  return diag;
}

// ========================== WEBHOOK HANDLER ==================================

function decodeBase64Url(input: string): string {
  const b64 = input.replace(/-/g, "+").replace(/_/g, "/");
  const padded = b64 + "=".repeat((4 - (b64.length % 4)) % 4);
  return atob(padded);
}

function normalizeWebhookFields(payload: any): {
  payload: any;
  eventType: string | null;
  resourceType: string | null;
  resourceId: string | null;
  eventId: string | null;
} {
  const p = payload && typeof payload === "object" ? payload : {};
  const topic = String(p.topic || "").trim().toLowerCase();
  const evt = String(p.event_type || "").trim().toLowerCase();
  const event = String(p.event || "").trim().toLowerCase();
  const eventType = event || (topic && evt ? `${topic}.${evt}` : (evt || null));
  const resourceType =
    (p.resource_type && String(p.resource_type).trim()) ||
    (topic && topic.split(".")[0]) ||
    (event && event.split(".")[0]) ||
    null;
  const resourceId =
    (p.resource_id && String(p.resource_id).trim()) ||
    (p.id && String(p.id).trim()) ||
    (p.resource && p.resource.id && String(p.resource.id).trim()) ||
    null;
  const eventId =
    (p.event_id && String(p.event_id).trim()) ||
    (p.idempotency_key && String(p.idempotency_key).trim()) ||
    null;

  return {
    payload: p,
    eventType,
    resourceType,
    resourceId,
    eventId,
  };
}

function parseIncomingWebhook(rawBody: string): {
  payload: any;
  eventType: string | null;
  resourceType: string | null;
  resourceId: string | null;
  eventId: string | null;
  parseMode: string;
} {
  const raw = String(rawBody || "").trim();
  if (!raw) {
    return {
      payload: {},
      eventType: null,
      resourceType: null,
      resourceId: null,
      eventId: null,
      parseMode: "empty",
    };
  }

  // Compact JWS format: header.payload.signature
  try {
    const parts = raw.split(".");
    if (parts.length === 3) {
      const payloadJson = decodeBase64Url(parts[1]);
      const payload = JSON.parse(payloadJson);
      return {
        ...normalizeWebhookFields(payload),
        parseMode: "jws",
      };
    }
  } catch {
    // Fall through to plain JSON attempt.
  }

  // Plain JSON payload
  try {
    const payload = JSON.parse(raw);
    return {
      ...normalizeWebhookFields(payload),
      parseMode: "json",
    };
  } catch {
    return {
      payload: {},
      eventType: null,
      resourceType: null,
      resourceId: null,
      eventId: null,
      parseMode: "unknown",
    };
  }
}

async function handleWebhookPost(req: Request): Promise<any> {
  const rawBody = await req.text();
  const parsed = parseIncomingWebhook(rawBody);
  const resourceType = parsed.resourceType;
  const resourceId = parsed.resourceId;
  const eventType = parsed.eventType;

  // Store in SQLite
  await sqlite.execute({
    sql:
      `INSERT INTO webhook_events (raw_body, resource_type, resource_id, event_type)
          VALUES (?, ?, ?, ?)`,
    args: [rawBody, resourceType, resourceId, eventType],
  });

  // Invalidate relevant caches
  if (resourceType && WEBHOOK_CACHE_MAP[resourceType]) {
    for (const et of WEBHOOK_CACHE_MAP[resourceType]) {
      await cacheInvalidate(et);
    }
  }

  return {
    ok: true,
    event_type: eventType,
    resource_type: resourceType,
    resource_id: resourceId,
    parse_mode: parsed.parseMode,
  };
}

// ========================== WEBHOOK QUERY ENDPOINTS ==========================

async function handleWebhookEvents(params: Record<string, string>) {
  const limit = parseInt(params.limit || "200", 10);
  const offset = parseInt(params.offset || "0", 10);
  const sinceId = parseInt(params.since_id || "0", 10);
  const search = params.search || "";
  const typeFilter = params.type || "";
  const sourceFilter = params.source || "";
  const fromDate = params.from || "";
  const toDate = params.to || "";

  const conditions: string[] = [];
  const args: any[] = [];

  if (sinceId > 0) {
    conditions.push("id > ?");
    args.push(sinceId);
  }
  if (search) {
    conditions.push(
      "(event_type LIKE ? OR resource_type LIKE ? OR resource_id LIKE ?)",
    );
    const s = `%${search}%`;
    args.push(s, s, s);
  }
  if (typeFilter) {
    conditions.push("event_type LIKE ?");
    args.push(`%${typeFilter}%`);
  }
  if (sourceFilter === "appfolio" || sourceFilter === "has_data") {
    conditions.push("length(raw_body) > 2");
  } else if (sourceFilter === "empty") {
    conditions.push("length(raw_body) <= 2");
  }
  if (fromDate) {
    conditions.push("received_at >= ?");
    args.push(fromDate);
  }
  if (toDate) {
    conditions.push("received_at <= ?");
    args.push(toDate);
  }

  const whereClause = conditions.length > 0
    ? "WHERE " + conditions.join(" AND ")
    : "";

  const result = await sqlite.execute({
    sql: `SELECT id, received_at as ts, event_type as type,
                 resource_type, resource_id, raw_body,
                 CASE WHEN length(raw_body) > 2 THEN 'has_data' ELSE 'empty' END as body_status
          FROM webhook_events
          ${whereClause}
          ORDER BY id DESC
          LIMIT ? OFFSET ?`,
    args: [...args, limit, offset],
  });

  const total = await sqlite.execute({
    sql: `SELECT COUNT(*) as cnt FROM webhook_events ${whereClause}`,
    args: args,
  });

  const eventRows = rowsAsObjects(result);
  const totalRows = rowsAsObjects(total);

  return {
    ok: true,
    count: eventRows.length,
    total: totalRows[0]?.cnt || 0,
    events: eventRows.map((r) => {
      const parsed = parseIncomingWebhook(r.raw_body || "");
      const rawObj: any = parsed.payload || {};
      const src = r.body_status === "has_data" ? "appfolio" : "empty";
      const resolvedType = parsed.eventType || r.type || null;
      const resolvedResourceType = parsed.resourceType || r.resource_type || null;
      const resolvedResourceId = parsed.resourceId || r.resource_id || null;
      const title = resolvedType
        ? `${resolvedType} → ${resolvedResourceType || "?"}/${resolvedResourceId || "?"}`
        : "Webhook Event";
      return {
        id: r.id,
        ts: r.ts,
        type: resolvedType,
        event_type: rawObj.event_type || resolvedType || null,
        topic: rawObj.topic || null,
        event_id: parsed.eventId || rawObj.event_id || null,
        resource_type: resolvedResourceType,
        resource_id: resolvedResourceId,
        body_status: r.body_status,
        title,
        body: r.raw_body || "",
        priority: "normal",
        source: src,
        raw: rawObj,
      };
    }),
  };
}

async function handleWebhookStats(_params: Record<string, string>) {
  const totalResult = await sqlite.execute(
    `SELECT COUNT(*) as total,
            SUM(CASE WHEN processed = 0 THEN 1 ELSE 0 END) as pending,
            SUM(CASE WHEN length(raw_body) > 2 THEN 1 ELSE 0 END) as has_data,
            SUM(CASE WHEN length(raw_body) <= 2 THEN 1 ELSE 0 END) as empty_body
     FROM webhook_events`,
  );

  const byType = await sqlite.execute(
    `SELECT COALESCE(event_type, 'unknown') as type, COUNT(*) as count
     FROM webhook_events
     GROUP BY event_type
     ORDER BY count DESC`,
  );

  const bySource = await sqlite.execute(
    `SELECT CASE WHEN length(raw_body) > 2 THEN 'appfolio' ELSE 'empty' END as source,
            COUNT(*) as count
     FROM webhook_events
     GROUP BY source`,
  );

  const byDay = await sqlite.execute(
    `SELECT date(received_at) as day, COUNT(*) as count
     FROM webhook_events
     WHERE received_at >= datetime('now', '-30 days')
     GROUP BY day
     ORDER BY day DESC`,
  );

  const statsRows = rowsAsObjects(totalResult);
  const stats = statsRows[0] || {};
  return {
    ok: true,
    total: stats.total || 0,
    pending: stats.pending || 0,
    has_data: stats.has_data || 0,
    empty_body: stats.empty_body || 0,
    by_type: rowsAsObjects(byType),
    by_source: rowsAsObjects(bySource),
    by_day: rowsAsObjects(byDay),
  };
}

// ========================== CACHE MANAGEMENT ENDPOINTS =======================

async function handleCacheStats() {
  const stats = await sqlite.execute(
    `SELECT entity_type,
            COUNT(*) as entries,
            MAX(cached_at) as last_cached,
            SUM(record_count) as total_records
     FROM api_cache
     GROUP BY entity_type`,
  );
  const webhookCount = await sqlite.execute(
    `SELECT COUNT(*) as total,
            SUM(CASE WHEN processed = 0 THEN 1 ELSE 0 END) as pending,
            MAX(id) as max_id
     FROM webhook_events`,
  );
  const turnRecordCount = await sqlite.execute(
    `SELECT COUNT(*) as total FROM turn_records`,
  );
  const whRows = rowsAsObjects(webhookCount);
  const trRows = rowsAsObjects(turnRecordCount);

  // Storage usage breakdown
  const cacheBytes = await getCacheSizeBytes();
  const webhookBytes = await getWebhookSizeBytes();
  const totalBytes = cacheBytes + webhookBytes;
  const budgetMB = (STORAGE_BUDGET_BYTES / 1024 / 1024).toFixed(1);

  return {
    ok: true,
    version: "v8.9",
    database: TURSO_URL ? "turso" : "valtown_sqlite",
    cache: rowsAsObjects(stats),
    webhooks: whRows[0] || { total: 0, pending: 0, max_id: 0 },
    turn_records: trRows[0]?.total || 0,
    storage: {
      cache_bytes: cacheBytes,
      webhook_bytes: webhookBytes,
      total_bytes: totalBytes,
      total_mb: (totalBytes / 1024 / 1024).toFixed(2),
      budget_mb: budgetMB,
      usage_pct: ((totalBytes / STORAGE_BUDGET_BYTES) * 100).toFixed(1),
    },
  };
}

// Manual storage cleanup endpoint
async function handleStorageCleanup() {
  const before = await getCacheSizeBytes();
  // 1. Purge expired cache entries
  await sqlite.execute(
    `DELETE FROM api_cache WHERE datetime(expires_at) < datetime('now')`,
  );
  // 2. Run webhook cleanup
  const wh = await webhookCleanup();
  const after = await getCacheSizeBytes();
  return {
    ok: true,
    freed_bytes: before - after,
    freed_mb: ((before - after) / 1024 / 1024).toFixed(2),
    webhook_deleted: wh,
    cache_bytes_now: after,
  };
}

async function handleCacheInvalidate(params: Record<string, string>) {
  const entityType = params.type;
  if (!entityType) {
    await sqlite.execute(`DELETE FROM api_cache`);
    return { ok: true, message: "All caches cleared" };
  }
  await cacheInvalidate(entityType);
  return { ok: true, message: `Cache cleared for ${entityType}` };
}

async function handleForceRefresh(params: Record<string, string>) {
  const entityType = params.type;
  if (!entityType) return { ok: false, error: "Missing type parameter" };

  await cacheInvalidate(entityType);

  switch (entityType) {
    case "work_orders":
      return handleWorkOrders(params);
    case "turns":
      return handleTurns(params);
    case "turn_work_orders":
      return handleTurnWorkOrders(params);
    case "vendors":
      return handleVendors(params);
    case "inspections":
      return handleInspections(params);
    case "properties":
      return handleProperties(params);
    case "property_groups":
      return handlePropertyGroups(params);
    case "property_map":
      return handlePropertyMap(params);
    case "recent_tasks":
      return handleRecentTasks(params);
    case "upcoming_moveouts":
      return handleUpcomingMoveouts(params);
    case "labor":
      return handleLabor(params);
    case "bills":
      return handleBills(params);
    default:
      return { ok: false, error: `Unknown entity type: ${entityType}` };
  }
}

