async function handleMigrateV8() {
  const result = await sqlite.execute(
    `UPDATE webhook_events
     SET processed = 1, processed_at = datetime('now')
     WHERE length(raw_body) <= 2 AND processed = 0`,
  );
  return {
    ok: true,
    message: `Marked ${
      (result as any).rowsAffected || 0
    } empty events as processed`,
  };
}

async function handleWebhookMigrate() {
  // blob→SQLite migration for webhook events
  let migrated = 0;
  try {
    const stored = await blob.getJSON("webhook_events");
    if (Array.isArray(stored) && stored.length > 0) {
      for (const evt of stored) {
        await sqlite.execute({
          sql:
            `INSERT INTO webhook_events (received_at, raw_body, resource_type, resource_id, event_type)
                VALUES (?, ?, ?, ?, ?)`,
          args: [
            evt.ts || new Date().toISOString(),
            JSON.stringify(evt),
            evt.resource_type || null,
            evt.resource_id || null,
            evt.type || null,
          ],
        });
        migrated++;
      }
      // Clear blob after successful migration
      await blob.setJSON("webhook_events", []);
    }
  } catch {
    /* no blob data to migrate */
  }
  return {
    ok: true,
    migrated,
    message: migrated > 0
      ? `Migrated ${migrated} events from blob`
      : "No blob data to migrate",
  };
}

// ========================== PASSTHROUGH / RAW PROXY =========================

// Matches v7: routes /api/v0/... → api.appfolio.com, /api/v2/... → flraz.appfolio.com
// Uses correct credentials per API version
async function handlePassthrough(
  params: Record<string, string>,
  req: Request,
): Promise<any> {
  const targetPath = params.path;
  if (!targetPath) return { ok: false, error: "Missing path parameter" };

  let cleanPath = targetPath;
  if (targetPath.startsWith("http")) {
    try {
      const u = new URL(targetPath);
      cleanPath = u.pathname + u.search;
    } catch {
      /* use as-is */
    }
  }

  // Route to correct domain AND credentials based on API version
  const isV0 = cleanPath.startsWith("/api/v0");
  const baseDomain = isV0 ? AF_DB : AF_REPORTS;
  const targetUrl = `${baseDomain}${cleanPath}`;
  const hdrs: Record<string, string> = isV0
    ? { ...dbHeaders() }
    : { ...reportsHeaders() };
  const ct = req.headers.get("content-type");
  if (ct) hdrs["Content-Type"] = ct;

  const resp = await fetchWithTimeout(targetUrl, {
    method: req.method,
    headers: hdrs,
    body: req.method !== "GET" && req.method !== "HEAD"
      ? await req.text()
      : undefined,
  });

  const body = await resp.text();
  return new Response(body, {
    status: resp.status,
    statusText: resp.statusText,
    headers: {
      "Content-Type": resp.headers.get("Content-Type") || "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Headers": "*",
    },
  });
}

// ========================== SQL ADMIN ENDPOINTS =============================
// Guarded by PROXY_ADMIN_KEY env var — set it in Val Town settings to enable.
// Both endpoints require ?key=<PROXY_ADMIN_KEY> in the request URL.

async function handleSqlQuery(
  params: Record<string, string>,
  req: Request,
): Promise<any> {
  const adminKey = Deno.env.get("PROXY_ADMIN_KEY") || "";
  if (!adminKey) {
    return {
      ok: false,
      error: "sql_query disabled: set PROXY_ADMIN_KEY env var in Val Town to enable",
    };
  }
  if ((params.key || "") !== adminKey) {
    return { ok: false, error: "Unauthorized: invalid or missing key" };
  }

  let query = params.query || params.sql || "";
  if (!query) {
    try {
      const ct = req.headers.get("content-type") || "";
      if (ct.includes("application/json")) {
        const body = await req.json();
        query = body.query || body.sql || "";
      } else {
        const text = await req.text();
        const form = new URLSearchParams(text);
        query = form.get("query") || form.get("sql") || "";
      }
    } catch { /* keep empty */ }
  }
  if (!query) return { ok: false, error: "Missing query parameter" };

  const normalized = query.trim().replace(/\s+/g, " ").toUpperCase();
  const allowed =
    normalized.startsWith("SELECT") ||
    normalized.startsWith("PRAGMA") ||
    normalized.startsWith("EXPLAIN") ||
    normalized.startsWith("WITH");
  if (!allowed) {
    return {
      ok: false,
      error:
        "sql_query only allows SELECT / PRAGMA / EXPLAIN / WITH. Use sql_execute for writes.",
    };
  }

  try {
    const result = await sqlite.execute(query);
    const columns: string[] = result.columns || [];
    const rows = rowsAsObjects(result);
    return { ok: true, rows, columns, count: rows.length };
  } catch (err: any) {
    return { ok: false, error: err.message };
  }
}

async function handleSqlExecute(
  params: Record<string, string>,
  req: Request,
): Promise<any> {
  const adminKey = Deno.env.get("PROXY_ADMIN_KEY") || "";
  if (!adminKey) {
    return {
      ok: false,
      error: "sql_execute disabled: set PROXY_ADMIN_KEY env var in Val Town to enable",
    };
  }
  if ((params.key || "") !== adminKey) {
    return { ok: false, error: "Unauthorized: invalid or missing key" };
  }

  let sqlStmt = params.query || params.sql || "";
  let sqlArgs: any[] = [];
  if (!sqlStmt) {
    try {
      const ct = req.headers.get("content-type") || "";
      if (ct.includes("application/json")) {
        const body = await req.json();
        sqlStmt = body.sql || body.query || "";
        sqlArgs = body.args || body.params || [];
      } else {
        const text = await req.text();
        const form = new URLSearchParams(text);
        sqlStmt = form.get("query") || form.get("sql") || "";
      }
    } catch { /* keep empty */ }
  }
  if (!sqlStmt) return { ok: false, error: "Missing sql/query parameter" };

  // Prevent accidental SELECT via execute — use sql_query instead
  const normalized = sqlStmt.trim().toUpperCase();
  if (normalized.startsWith("SELECT") || normalized.startsWith("EXPLAIN")) {
    return {
      ok: false,
      error: "Use sql_query for SELECT/EXPLAIN statements",
    };
  }

  try {
    const result = await sqlite.execute({ sql: sqlStmt, args: sqlArgs });
    return {
      ok: true,
      rowsAffected: result.rowsAffected || 0,
      lastInsertRowid: result.lastInsertRowid != null
        ? Number(result.lastInsertRowid)
        : null,
    };
  } catch (err: any) {
    return { ok: false, error: err.message };
  }
}
