// ========================== APPFOLIO API HELPERS ============================

// Helper: ISO date N days ago (matches v7)
function daysAgo(n: number): string {
  const d = new Date();
  d.setDate(d.getDate() - n);
  return d.toISOString().split("T")[0];
}

function today(): string {
  return new Date().toISOString().split("T")[0];
}

// Reports API v2 — POST to initiate with JSON body, GET to paginate
// Auth: AUTH_V2 (btoa client_id:client_secret)
// Base: https://flraz.appfolio.com/api/v2/reports/{report}.json
async function fetchReport(
  reportName: string,
  filters: Record<string, any> = {},
): Promise<any[]> {
  const reportUrl = `${AF_REPORTS}/api/v2/reports/${reportName}.json`;

  // Initial POST with JSON body (NOT form-encoded — matches v7)
  const initResp = await fetchWithTimeout(reportUrl, {
    method: "POST",
    headers: { ...reportsHeaders(), "Content-Type": "application/json" },
    body: JSON.stringify(filters),
  });

  if (!initResp.ok) {
    const errText = await initResp.text().catch(() => "");
    throw new Error(
      `Report ${reportName} failed: ${initResp.status} ${initResp.statusText} — ${
        errText.substring(0, 300)
      }`,
    );
  }

  let data = await initResp.json();
  let allRows: any[] = [];

  if (data.results) allRows = allRows.concat(data.results);
  else if (Array.isArray(data.data)) allRows = allRows.concat(data.data);
  else if (Array.isArray(data)) return data;

  // Paginate via next_page_url (GET requests, up to 50 pages)
  let nextUrl: string | null = data.next_page_url || data.next_page_path ||
    null;
  let page = 1;
  while (nextUrl && page < 50) {
    if (page > 1) await delay(PAGE_DELAY_MS); // rate-limit pacing
    const fullUrl = nextUrl.startsWith("http")
      ? nextUrl
      : `${AF_REPORTS}${nextUrl}`;
    const pageResp = await fetchWithTimeout(fullUrl, {
      headers: reportsHeaders(),
    });
    if (!pageResp.ok) break;
    data = await pageResp.json();
    if (data.results) allRows = allRows.concat(data.results);
    else if (Array.isArray(data.data)) allRows = allRows.concat(data.data);
    else break;
    nextUrl = data.next_page_url || data.next_page_path || null;
    page++;
  }
  return allRows;
}

// Database API v0 — REST with Developer-ID header
// Auth: AUTH_V0 (pre-encoded Base64 token, separate from v2)
// Base: https://api.appfolio.com/api/v0/{resource}
// Rate limits: 8 req/s, 256 req/min, 4096 req/hr
async function fetchDbApi(
  path: string,
  maxRecords = 9999,
): Promise<any[]> {
  let allResults: any[] = [];
  let nextPath: string | null = path;
  let pageNum = 0;

  while (nextPath && allResults.length < maxRecords) {
    if (pageNum > 0) await delay(PAGE_DELAY_MS); // rate-limit pacing
    const fullUrl = nextPath.startsWith("http")
      ? nextPath
      : `${AF_DB}${nextPath}`;
    const resp = await fetchWithTimeout(fullUrl, { headers: dbHeaders() });
    if (!resp.ok) {
      const errText = await resp.text().catch(() => "");
      throw new Error(
        `DB API failed: ${resp.status} — ${errText.substring(0, 200)}`,
      );
    }
    const data = await resp.json();
    const results = data.results || data.data ||
      (Array.isArray(data) ? data : []);
    allResults = allResults.concat(results);
    nextPath = data.next_page_path || null;
    if (results.length === 0) break;
    pageNum++;
  }
  return allResults.slice(0, maxRecords);
}
