// ---------- webhook_resolve (resolve resource_type/resource_id to live record)
// Purpose: resource IDs are opaque UUIDs; this endpoint resolves them via API lookup.
async function handleWebhookResolve(params: Record<string, string>) {
  const resourceType = (params.resource_type || params.type || "").trim();
  const resourceId = (params.resource_id || params.id || "").trim();
  if (!resourceType || !resourceId) {
    return {
      ok: false,
      error: "Missing resource_type/type or resource_id/id",
    };
  }

  const normalizeType = (raw: string): string => {
    let t = String(raw || "").trim().toLowerCase();
    if (!t) return "";
    if (t.includes(".")) t = t.split(".")[0];
    t = t.replace(/[^a-z0-9_]/g, "");
    if (t.endsWith("ies")) t = t.slice(0, -3) + "y";
    else if (t.endsWith("s")) t = t.slice(0, -1);
    return t;
  };

  const singular = normalizeType(resourceType);
  const endpointMap: Record<string, string> = {
    work_order: "work_orders",
    unit_turn: "unit_turns",
    inspection: "inspections",
    vendor: "vendors",
    property: "properties",
    tenant: "tenants",
    lease: "leases",
    bill: "bills",
    task: "tasks",
  };
  const collection = endpointMap[singular] || `${singular}s`;
  const byIdPath = `/api/v0/${collection}/${encodeURIComponent(resourceId)}`;
  const byFilterPath =
    `/api/v0/${collection}?filters[Id]=${encodeURIComponent(resourceId)}&page[size]=1`;

  const toSummary = (record: any) => {
    const title =
      record.Title ||
      record.Name ||
      record.Unit ||
      record.PropertyName ||
      record.Description ||
      record.Id ||
      resourceId;
    const status =
      record.Status ||
      record.WorkOrderStatus ||
      record.UnitTurnStatus ||
      record.State ||
      "";
    const reference =
      record.Number ||
      record.Reference ||
      record.WorkOrderNumber ||
      record.Unit ||
      "";
    return { title, status, reference };
  };

  const fetchRecord = async (path: string): Promise<{ ok: boolean; record?: any; domain?: string; status?: number; detail?: string }> => {
    let domain = AF_REPORTS;
    let r = await fetchWithTimeout(`${AF_REPORTS}${path}`, { headers: dbHeaders() });
    if (r.status === 401 || r.status === 403 || r.status === 404) {
      domain = AF_DB;
      r = await fetchWithTimeout(`${AF_DB}${path}`, { headers: dbHeaders() });
    }
    if (!r.ok) {
      const detail = await r.text().catch(() => "");
      return { ok: false, domain, status: r.status, detail: detail.substring(0, 500) };
    }
    const payload = await r.json().catch(() => ({}));
    const record = (payload && payload.data && !Array.isArray(payload.data) ? payload.data : null) ||
      (payload && payload.data && Array.isArray(payload.data) ? payload.data[0] : null) ||
      (payload && payload.results && payload.results[0]) ||
      (Array.isArray(payload) ? payload[0] : null) ||
      payload ||
      null;
    return { ok: !!record, record, domain, status: r.status };
  };

  // 1) Direct /{id}
  let found = await fetchRecord(byIdPath);
  if (!found.ok) {
    // 2) Fallback /?filters[Id]=...
    found = await fetchRecord(byFilterPath);
  }

  if (!found.ok || !found.record) {
    return {
      ok: false,
      error: `resolve failed: HTTP ${found.status || 404}`,
      status: found.status || 404,
      domain: found.domain || `${AF_REPORTS} + ${AF_DB}`,
      resource_type: singular,
      resource_id: resourceId,
      endpoint: byIdPath,
      detail: found.detail || "Not found via ID or filters[Id] lookup",
    };
  }

  return {
    ok: true,
    resource_type: singular,
    resource_id: resourceId,
    endpoint: found.domain === AF_DB ? byFilterPath : byIdPath,
    domain: found.domain || AF_REPORTS,
    summary: toSummary(found.record),
    record: found.record,
  };
}

