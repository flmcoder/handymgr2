// ---------- property_groups (DB API v0 — with domain fallback) --------------
// Matches v7: URL-encoded filter, page size 100, 401 fallback to tenant domain
async function handlePropertyGroups(params: Record<string, string>) {
  const cacheKey = "property_groups";
  const cached = await cacheGet(cacheKey, "property_groups");
  if (cached) {
    return {
      ok: true,
      results: cached.data,
      count: cached.record_count,
      cached_at: cached.cached_at,
      from_cache: true,
    };
  }

  // DB API v0 requires filters[Id] or filters[LastUpdatedAtFrom] on all list endpoints
  const lastFrom = params["filters[LastUpdatedAtFrom]"] || "2024-01-01T00:00:00Z";
  const pgSize = params["page[size]"] || "100";
  const pgPath = `/api/v0/property_groups?filters%5BLastUpdatedAtFrom%5D=${encodeURIComponent(lastFrom)}&page%5Bsize%5D=${pgSize}`;

  let pgResp = await fetchWithTimeout(`${AF_DB}${pgPath}`, {
    headers: dbHeaders(),
  });

  // Fallback: if DB API domain returns 401, try tenant domain with v0 creds
  let domainUsed = AF_DB;
  if (pgResp.status === 401) {
    domainUsed = AF_REPORTS;
    pgResp = await fetchWithTimeout(`${AF_REPORTS}${pgPath}`, {
      headers: dbHeaders(),
    });
  }

  if (!pgResp.ok) {
    const errBody = await pgResp.text().catch(() => "");
    return {
      ok: false,
      error: "property_groups fetch failed: HTTP " + pgResp.status,
      status: pgResp.status,
      domain: domainUsed,
      detail: errBody.substring(0, 500),
    };
  }

  const pgData = await pgResp.json();
  let allGroups = pgData.results || pgData.data ||
    (Array.isArray(pgData) ? pgData : []);

  // Paginate if needed
  let nextPage: string | null = pgData.next_page_path || null;
  let page = 1;
  while (nextPage && page < 20) {
    const fullUrl = nextPage.startsWith("http")
      ? nextPage
      : `${domainUsed}${nextPage}`;
    const nr = await fetchWithTimeout(fullUrl, { headers: dbHeaders() });
    if (!nr.ok) break;
    const nd = await nr.json();
    const nResults = nd.results || nd.data || [];
    allGroups = allGroups.concat(nResults);
    nextPage = nd.next_page_path || null;
    if (nResults.length === 0) break;
    page++;
  }

  await cacheSet(cacheKey, "property_groups", allGroups, allGroups.length);
  return {
    ok: true,
    results: allGroups,
    count: allGroups.length,
    domain: domainUsed,
    from_cache: false,
  };
}

// ---------- property_map (DB API v0 — UUID→{name,address} with fallback) ----
// Matches v7: URL-encoded filter, page size 200, 401 fallback, stores address
async function handlePropertyMap(_params: Record<string, string>) {
  const cacheKey = "property_map";
  const cached = await cacheGet(cacheKey, "property_map");
  if (cached) {
    return {
      ok: true,
      property_uuid_map: cached.data,
      cached_at: cached.cached_at,
      from_cache: true,
    };
  }

  // DB API v0 requires filters[LastUpdatedAtFrom] on list endpoints
  const pmPath = "/api/v0/properties?filters%5BLastUpdatedAtFrom%5D=2024-01-01T00%3A00%3A00Z&page%5Bsize%5D=200";

  let pmResp = await fetchWithTimeout(`${AF_DB}${pmPath}`, {
    headers: dbHeaders(),
  });
  let pmDomain = AF_DB;
  if (pmResp.status === 401) {
    pmDomain = AF_REPORTS;
    pmResp = await fetchWithTimeout(`${AF_REPORTS}${pmPath}`, {
      headers: dbHeaders(),
    });
  }

  if (!pmResp.ok) {
    const errBody = await pmResp.text().catch(() => "");
    return {
      ok: false,
      error: "property_map fetch failed: HTTP " + pmResp.status,
      domain: pmDomain,
      detail: errBody.substring(0, 500),
    };
  }

  const pmData = await pmResp.json();
  let dbProps = pmData.results || pmData.data ||
    (Array.isArray(pmData) ? pmData : []);

  // Paginate (cap at 2000)
  let pmNext: string | null = pmData.next_page_path || null;
  let pmPage = 1;
  while (pmNext && dbProps.length < 2000 && pmPage < 20) {
    const fu = pmNext.startsWith("http") ? pmNext : `${pmDomain}${pmNext}`;
    const nr = await fetchWithTimeout(fu, { headers: dbHeaders() });
    if (!nr.ok) break;
    const nd = await nr.json();
    const nR = nd.results || nd.data || [];
    dbProps = dbProps.concat(nR);
    pmNext = nd.next_page_path || null;
    if (nR.length === 0) break;
    pmPage++;
  }

  // Build UUID → { name, address } map (matches v7)
  const propMap: Record<string, { name: string; address: string }> = {};
  dbProps.forEach((p: any) => {
    if (p.Id) {
      propMap[p.Id] = {
        name: p.Name || p.PropertyName || "",
        address: p.Address1 || p.StreetAddress || "",
      };
    }
  });

  await cacheSet(
    cacheKey,
    "property_map",
    propMap,
    Object.keys(propMap).length,
  );
  return {
    ok: true,
    property_uuid_map: propMap,
    count: Object.keys(propMap).length,
    domain: pmDomain,
    from_cache: false,
  };
}

