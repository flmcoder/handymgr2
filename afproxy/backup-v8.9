// ========================== MAIN ROUTER =====================================

export default async function (req: Request): Promise<Response> {
  // CORS preflight — always respond immediately
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: CORS_HEADERS });
  }

  try {
    // Validate environment variables (matches v7)
    if (!V2_CLIENT_ID || !V2_CLIENT_SECRET || !DEV) {
      return corsJson(
        {
          ok: false,
          error:
            "Missing environment variables. Required: AF_V2_CLIENT_ID, AF_V2_CLIENT_SECRET, AF_DEVELOPER_ID, AF_V0_AUTH.",
        },
        500,
      );
    }

    // Initialize SQLite tables (no-op after first run)
    await ensureTables();

    const url = new URL(req.url);
    const action = url.searchParams.get("action");
    const params = Object.fromEntries(url.searchParams.entries());

    // ---- Webhook POST (AppFolio sends POST with no ?action param) ----
    if (req.method === "POST" && !action) {
      const result = await handleWebhookPost(req);
      return corsJson(result);
    }

    // ---- POST actions ----
    if (req.method === "POST" && action) {
      let result: any;
      switch (action) {
        case "turn_records":
          result = await handleTurnRecords(params, req);
          break;
        case "turn_record_stage":
          result = await handleTurnRecordStage(req);
          break;
        case "report":
          result = await handleGenericReport(params, req);
          break;
        case "passthrough":
          result = await handlePassthrough(params, req);
          // passthrough returns a raw Response
          if (result instanceof Response) return result;
          break;
        case "webhook":
          // Legacy v7 webhook POST format (action=webhook)
          result = await handleWebhookPost(req);
          break;
        case "webhook_resolve":
          result = await handleWebhookResolve(params);
          break;
        default:
          result = { ok: false, error: `Unknown POST action: ${action}` };
      }
      return corsJson(result);
    }

    // ---- GET actions ----
    let result: any;
    switch (action) {
      // Data endpoints (cached)
      case "work_orders":
        result = await handleWorkOrders(params);
        break;
      case "vendors":
        result = await handleVendors(params);
        break;
      case "properties":
        result = await handleProperties(params);
        break;
      case "turns":
        result = await handleTurns(params);
        break;
      case "inspections":
        result = await handleInspections(params);
        break;
      case "property_groups":
        result = await handlePropertyGroups(params);
        break;
      case "property_map":
        result = await handlePropertyMap(params);
        break;
      case "recent_tasks":
        result = await handleRecentTasks(params);
        break;
      case "upcoming_moveouts":
        result = await handleUpcomingMoveouts(params);
        break;
      case "turn_work_orders":
        result = await handleTurnWorkOrders(params);
        break;
      case "labor":
        result = await handleLabor(params);
        break;
      case "bills":
        result = await handleBills(params);
        break;

      // Detail endpoints (not cached)
      case "wo_notes":
        result = await handleWoNotes(params);
        break;
      case "turn_records":
        result = await handleTurnRecords(params);
        break;

      // Generic report (GET form — typically use POST for filters)
      case "report":
        result = await handleGenericReport(params, req);
        break;

      // Webhook endpoints
      case "webhook_events":
        result = await handleWebhookEvents(params);
        break;
      case "webhook_stats":
        result = await handleWebhookStats(params);
        break;
      case "webhook_resolve":
        result = await handleWebhookResolve(params);
        break;
      case "webhook_migrate":
        result = await handleWebhookMigrate();
        break;

      // SQL admin (guarded by PROXY_ADMIN_KEY)
      case "sql_query":
        result = await handleSqlQuery(params, req);
        break;
      case "sql_execute":
        result = await handleSqlExecute(params, req);
        break;

      // Cache management
      case "cache_stats":
        result = await handleCacheStats();
        break;
      case "cache_invalidate":
        result = await handleCacheInvalidate(params);
        break;
      case "force_refresh":
        result = await handleForceRefresh(params);
        break;
      case "storage_cleanup":
        result = await handleStorageCleanup();
        break;

      // Migration
      case "migrate_v8":
        result = await handleMigrateV8();
        break;

      // Health
      case "ping":
        result = await handlePing();
        break;

      // Diagnostic — dump raw SQLite info to see actual row format + schemas
      case "debug_sqlite":
        result = await handleDebugSqlite();
        break;

      // Passthrough for direct API calls (GET form)
      case "passthrough":
        result = await handlePassthrough(params, req);
        if (result instanceof Response) return result;
        break;

      // Raw proxy — v7 compat: ?path=/api/v0/... (no action param needed)
      default:
        // Check if there's a ?path= param (v7 raw proxy pattern)
        if (params.path) {
          result = await handlePassthrough(params, req);
          if (result instanceof Response) return result;
        } else if (!action) {
          // No action, no path — show help
          result = {
            ok: true,
            proxy: "v8.9",
            database: TURSO_URL ? "turso" : "valtown_sqlite",
            reports_domain: AF_REPORTS,
            db_domain: AF_DB,
            endpoints: [
              "?action=ping",
              "?action=work_orders&days=180",
              "?action=vendors",
              "?action=properties",
              "?action=turns&days=90",
              "?action=inspections&days=180",
              "?action=labor&days=1&statuses=8",
              "?action=property_groups",
              "?action=property_map",
              "?action=upcoming_moveouts&days=60",
              "?action=turn_work_orders&days=90",
              "?action=bills&days=180",
              "?action=wo_notes&wo_id=UUID",
              "?action=recent_tasks",
              "?action=turn_records",
              "?action=webhook_events",
              "?action=webhook_stats",
              "?action=webhook_resolve&resource_type=work_order&resource_id=UUID",
              "?action=cache_stats",
              "?action=cache_invalidate&type=ENTITY",
              "?action=force_refresh&type=ENTITY",
              "?action=storage_cleanup",
              "?action=debug_sqlite",
              "?action=sql_query&key=KEY&query=SELECT...",
              "?action=sql_execute&key=KEY&query=UPDATE... (also POST)",
              "?action=report&name=REPORT_NAME (POST with filters)",
              "?action=passthrough&path=/api/v0/...",
            ],
          };
        } else {
          result = { ok: false, error: `Unknown action: ${action}` };
        }
    }

    return corsJson(result);
  } catch (err: any) {
    console.error("Proxy v8.9 error:", err);
    return corsJson(
      { ok: false, error: err.message || "Internal server error" },
      500,
    );
  }
}