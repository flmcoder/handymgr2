# Copy values into your shell before running tests/billing_smoke.ts
# Example:
#   set -a && source tests/billing_smoke.env.example && set +a

API_PROXY=https://your-proxy-host/path
PROXY_BEARER_TOKEN=

# Required for route-layer core checks
BILLING_GROUP_ID=

# Optional action-specific IDs
BILLING_VENDOR_ID=
BILLING_PROPERTY_ID=
BILLING_WO_ID=
BILLING_WO_NUMBER=
BILLING_INVOICE_NUMBER=

# Optional due range override (defaults to today if blank)
BILLING_DUE_FROM=
BILLING_DUE_TO=
